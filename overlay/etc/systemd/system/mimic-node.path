[Unit]
Description=Watch for Mimic-Node Staging Configuration Changes
Requires=mimic-node-mount.service
After=mimic-node-mount.service

[Path]
# Apply only after the staging writer closes the file. A failed validation
# leaves it staged without repeatedly activating the service.
PathChanged=/etc/sing-box/config.new
Unit=mimic-node-deploy.service

[Install]
WantedBy=multi-user.target
