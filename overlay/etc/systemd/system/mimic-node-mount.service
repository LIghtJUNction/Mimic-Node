[Unit]
Description=Mimic-Node Configuration Overlay Mount
After=local-fs.target
Before=sing-box.service
RequiresMountsFor=/var/lib/mimic-node /etc/sing-box /usr/share/mimic-node

[Service]
Type=oneshot
RemainAfterExit=yes
UMask=0077
ExecStart=/usr/bin/mimic-mount start
ExecStop=/usr/bin/mimic-mount stop

[Install]
WantedBy=multi-user.target
