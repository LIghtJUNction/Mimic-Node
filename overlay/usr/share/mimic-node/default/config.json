{
  "log": {
    "disabled": false,
    "level": "warn",
    "output": "",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "google",
        "type": "h3",
        "server": "dns.google",
        "server_port": 443,
        "path": "/dns-query"
      },
      {
        "tag": "alidns",
        "type": "udp",
        "server": "223.5.5.5"
      },
      {
        "tag": "hosts",
        "type": "hosts"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-cn",
        "server": "alidns"
      }
    ],
    "final": "google",
    "strategy": "prefer_ipv4",
    "disable_cache": false,
    "disable_expire": false,
    "cache_capacity": 4096
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-in",
      "listen": "::",
      "listen_port": 443,
      "users": [],
      "tls": {
        "enabled": true,
        "server_name": "",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "https://microsoft.com",
            "server_port": 443
          },
          "private_key": "",
          "short_id": []
        }
      }
    },
    {
      "type": "vless",
      "tag": "vless-ws-in",
      "listen": "::",
      "listen_port": 8080,
      "tcp_fast_open": true,
      "tcp_keep_alive": "5m",
      "tcp_keep_alive_interval": "75s",
      "transport": {
        "type": "ws",
        "path": "/vless-ws",
        "headers": {},
        "max_early_data": 0,
        "early_data_header_name": ""
      },
      "users": [],
      "tls": {
        "enabled": true,
        "server_name": "microsoft.com",
        "handshake_timeout": "15s",
        "kernel_tx": true
      }
    },
    {
      "type": "hysteria2",
      "tag": "hy2-in",
      "listen": "::",
      "listen_port": 443,
      "tcp_fast_open": true,
      "tcp_multi_path": false,
      "tcp_keep_alive": "5m",
      "tcp_keep_alive_interval": "75s",
      "disable_tcp_keep_alive": false,
      "udp_timeout": "5m",
      "up_mbps": 100,
      "down_mbps": 100,
      "users": [],
      "ignore_client_bandwidth": false,
      "tls": {
        "enabled": true,
        "alpn": ["h3"],
        "certificate_path": "/path/to/cert.pem",
        "key_path": "/path/to/key.pem",
        "handshake_timeout": "15s",
        "kernel_tx": true
      },
      "masquerade": "https://microsoft.com",
      "obfs": {
        "type": "salamander",
        "password": ""
      },
      "bbr_profile": "bbr",
      "brutal_debug": false,
      "transport": {
        "type": "http",
        "host": [],
        "path": "",
        "method": "",
        "headers": {},
        "idle_timeout": "15s",
        "ping_timeout": "15s"
      }
    },
    {
      "type": "tuic",
      "tag": "tuic-in",
      "listen": "::",
      "listen_port": 8443,
      "tcp_fast_open": true,
      "tcp_keep_alive": "5m",
      "tcp_keep_alive_interval": "75s",
      "users": [],
      "congestion_control": "bbr",
      "udp_relay_mode": "native",
      "udp_over_tcp": true,
      "tls": {
        "enabled": true,
        "server_name": "example.com",
        "certificate_path": "/path/to/cert.pem",
        "key_path": "/path/to/key.pem",
        "alpn": ["h3"]
      }
    },
    {
      "type": "anytls",
      "tag": "anytls-in",
      "listen": "::",
      "listen_port": 8444,
      "tcp_fast_open": true,
      "users": [],
      "padding_scheme": [
        "stop=8",
        "0=30-30",
        "1=100-400",
        "2=400-500,c,500-1000,c,500-1000,c,500-1000,c,500-1000",
        "3=9-9,500-1000",
        "4=500-1000",
        "5=500-1000",
        "6=500-1000",
        "7=500-1000"
      ],
      "tls": {
        "enabled": true,
        "server_name": "example.com",
        "certificate_path": "/path/to/cert.pem",
        "key_path": "/path/to/key.pem"
      }
    },
    {
      "type": "cloudflared",
      "tag": "cloudflared-in",
      "token": "",
      "ha_connections": 0,
      "protocol": "h2",
      "post_quantum": false,
      "edge_ip_version": 0,
      "grace_period": "",
      "region": "",
      "control_dialer": {
        "bind_interface": "",
        "routing_mark": 0,
        "reuse_addr": false,
        "connect_timeout": "5s",
        "tcp_fast_open": true,
        "udp_fragment": true
      },
      "tunnel_dialer": {
        "bind_interface": "",
        "routing_mark": 0,
        "reuse_addr": false,
        "connect_timeout": "5s",
        "tcp_fast_open": true,
        "udp_fragment": true
      }
    },
    {
      "type": "ssh",
      "tag": "ssh-in",
      "listen": "::",
      "listen_port": 22,
      "tcp_fast_open": true,
      "tcp_keep_alive": "5m",
      "tcp_keep_alive_interval": "75s",
      "users": []
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct",
      "detour": "",
      "bind_interface": "",
      "inet4_bind_address": "",
      "inet6_bind_address": "",
      "bind_address_no_port": false,
      "routing_mark": 0,
      "reuse_addr": false,
      "tcp_fast_open": true,
      "tcp_multi_path": false,
      "tcp_keep_alive": "5m",
      "tcp_keep_alive_interval": "75s",
      "disable_tcp_keep_alive": false,
      "udp_fragment": true,
      "domain_matcher": "mph",
      "fallback_delay": "300ms",
      "tfo": {
        "enabled": true,
        "write_buffer": 0,
        "read_buffer": 0
      },
      "chain": []
    },
    {
      "type": "block",
      "tag": "block"
    },
    {
      "type": "ssh",
      "tag": "ssh-out",
      "server": "127.0.0.1",
      "server_port": 22,
      "user": "root",
      "password": "",
      "private_key": "",
      "private_key_path": "$HOME/.ssh/id_rsa",
      "private_key_passphrase": "",
      "host_key": [],
      "host_key_algorithms": [],
      "client_version": "",
      "detour": "",
      "bind_interface": "",
      "routing_mark": 0,
      "reuse_addr": false,
      "connect_timeout": "5s",
      "tcp_fast_open": true,
      "udp_fragment": false,
      "domain_matcher": "mph"
    },
    {
      "type": "hysteria2",
      "tag": "hysteria2-out",
      "server": "127.0.0.1",
      "server_port": 443,
      "up_mbps": 100,
      "down_mbps": 100,
      "password": "",
      "obfs": {
        "type": "salamander",
        "password": ""
      },
      "tls": {
        "enabled": true,
        "server_name": "example.com",
        "insecure": false,
        "alpn": ["h3"]
      }
    },
    {
      "type": "tuic",
      "tag": "tuic-out",
      "server": "127.0.0.1",
      "server_port": 8443,
      "uuid": "",
      "password": "",
      "congestion_control": "bbr",
      "udp_relay_mode": "native",
      "udp_over_tcp": false,
      "tls": {
        "enabled": true,
        "server_name": "example.com",
        "insecure": false,
        "alpn": ["h3"]
      }
    }
  ],
  "route": {
    "dhcp_lease_files": [
      "/var/lib/dnsmasq/dnsmasq.leases",
      "/var/lib/odhcpd/dhcp.leases",
      "/var/lib/dhcp/dhcpd.leases",
      "/var/lib/kea/kea-leases.json"
    ],
    "rules": [
      {
        "inbound": "tun-in",
        "action": "sniff"
      },
      {
        "inbound": "vless-in",
        "action": "sniff"
      },
      {
        "inbound": "vless-ws-in",
        "action": "sniff"
      },
      {
        "inbound": "hy2-in",
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "outbound": "direct"
      },
      {
        "rule_set": ["geosite-cn", "geoip-cn"],
        "outbound": "block"
      },
      {
        "domain": [
          "openai.com",
          "api.openai.com",
          "anthropic.com",
          "claude.ai",
          "huggingface.co",
          "huggingface.com",
          "github.com",
          "api.github.com",
          "archlinux.org",
          "pypi.org",
          "files.pythonhosted.org",
          "npmjs.org",
          "docker.io",
          "registry-1.docker.io",
          "mistral.ai",
          "groq.com",
          "cohere.ai",
          "ai.google.dev",
          "generativeai.google.dev"
        ],
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "tag": "geosite-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-cn.srs"
      },
      {
        "tag": "geoip-cn",
        "type": "remote",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      }
    ],
    "http_clients": [
      {
        "tag": "default",
        "detour": "direct"
      }
    ],
    "final": "direct",
    "auto_detect_interface": false,
    "default_domain_resolver": {
      "server": "google",
      "strategy": "prefer_ipv4"
    }
  },
  "services": [
    {
      "type": "resolved",
      "tag": "resolved-dns",
      "listen": "127.0.0.53",
      "listen_port": 53
    },
    {
      "type": "ssm-api",
      "tag": "ssm-api",
      "listen": "127.0.0.1",
      "listen_port": 9090,
      "api": {
        "inbounds": ["ssm-api"],
        "outbounds": ["direct"]
      },
      "cache_path": "/var/lib/sing-box/ssm-cache.json"
    },
    {
      "type": "stats",
      "tag": "stats-api",
      "listen": "127.0.0.1",
      "listen_port": 9080,
      "stats": {
        "enabled": true,
        "inbounds": ["vless-in", "vless-ws-in", "hy2-in", "tun-in"],
        "outbounds": ["direct", "hysteria2-out", "ssh-out"]
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/var/lib/sing-box/cache.db",
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "external_ui": "",
      "external_ui_download_url": "https://github.com/MetaCubeX/Yacd-meta/archive/gh-pages.zip",
      "external_ui_download_detour": "",
      "secret": "mimic-node",
      "default_mode": "Rule",
      "access_control_allow_origin": ["*"],
      "access_control_allow_private_network": false
    }
  }
}
