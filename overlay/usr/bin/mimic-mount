#!/usr/bin/env bash
set -euo pipefail
umask 077

TARGET_DIR=/etc/sing-box
STATE_DIR=/var/lib/mimic-node
UPPER_DIR=$STATE_DIR/upper
WORK_DIR=$STATE_DIR/work
RUNTIME_DIR=/run/mimic-node
LOWER_BIND_DIR=$RUNTIME_DIR/lower
PACKAGE_DEFAULT_DIR=/usr/share/mimic-node/default

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
mount_field() { findmnt -rn -M "$1" -o "$2"; }
is_owned_overlay() {
    local fs source options
    fs=$(mount_field "$TARGET_DIR" FSTYPE) || return 1
    source=$(mount_field "$TARGET_DIR" SOURCE) || return 1
    options=$(mount_field "$TARGET_DIR" OPTIONS) || return 1
    [[ $fs == overlay && ( $source == mimic-node || $source == overlay ) ]] &&
        [[ ,$options, == *,upperdir="$UPPER_DIR",* ]] &&
        [[ ,$options, == *,workdir="$WORK_DIR",* ]]
}
is_original_lower() {
    # Once the overlay is absent, the bind must refer to the original directory.
    [[ $(stat -Lc '%d:%i' "$LOWER_BIND_DIR") == $(stat -Lc '%d:%i' "$TARGET_DIR") ]]
}

[[ $(id -u) == 0 ]] || die 'This script must run as root.'
case "${1:-}" in start|stop|status) ;; *) die "Usage: $0 {start|stop|status}" ;; esac

# Private root-owned runtime state also serializes direct and systemd calls.
install -d -m700 "$RUNTIME_DIR"
exec 9>"$RUNTIME_DIR/mount.lock"
flock -x 9

case "$1" in
    start)
        if mount_field "$TARGET_DIR" FSTYPE >/dev/null; then
            is_owned_overlay || die "Refusing to cover an unrelated mount at $TARGET_DIR."
            printf 'Mimic-Node overlay is already mounted.\n'
            exit 0
        fi
        if ! grep -qw overlay /proc/filesystems; then
            modprobe overlay || die 'OverlayFS kernel support is unavailable.'
        fi
        mkdir -p "$TARGET_DIR"
        install -d -m700 "$STATE_DIR" "$UPPER_DIR" "$WORK_DIR" "$LOWER_BIND_DIR"
        lower_created=false
        rollback_lower() {
            if $lower_created; then
                umount "$LOWER_BIND_DIR" || printf 'Warning: lower bind cleanup failed.\n' >&2
            fi
        }
        trap rollback_lower EXIT
        if mount_field "$LOWER_BIND_DIR" FSTYPE >/dev/null; then
            is_original_lower || die "Unrelated lower bind at $LOWER_BIND_DIR."
        else
            mount --bind "$TARGET_DIR" "$LOWER_BIND_DIR"
            lower_created=true
        fi
        mount -o remount,ro,bind "$LOWER_BIND_DIR"

        # Existing system config wins; defaults only fill missing files.
        lower_layers=$LOWER_BIND_DIR
        if [[ -d $PACKAGE_DEFAULT_DIR ]]; then
            lower_layers=$lower_layers:$PACKAGE_DEFAULT_DIR
        fi
        mount -t overlay mimic-node \
            -o "lowerdir=$lower_layers,upperdir=$UPPER_DIR,workdir=$WORK_DIR" "$TARGET_DIR"
        trap - EXIT
        printf 'Mimic-Node overlay mounted at %s.\n' "$TARGET_DIR"
        ;;
    stop)
        if mount_field "$TARGET_DIR" FSTYPE >/dev/null; then
            is_owned_overlay || die "Refusing to unmount an unrelated mount at $TARGET_DIR."
            umount "$TARGET_DIR"
        fi
        if mount_field "$LOWER_BIND_DIR" FSTYPE >/dev/null; then
            is_original_lower || die "Refusing to unmount an unrelated lower bind at $LOWER_BIND_DIR."
            umount "$LOWER_BIND_DIR"
        fi
        printf 'Mimic-Node overlay stopped; persistent state preserved.\n'
        ;;
    status)
        if is_owned_overlay; then
            findmnt -M "$TARGET_DIR"
        else
            printf 'Mimic-Node overlay is not mounted.\n'
            exit 3
        fi
        ;;
esac
